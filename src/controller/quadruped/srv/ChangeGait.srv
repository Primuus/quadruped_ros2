# 步态切换服务请求
uint8 gait_type            # 要切换的步态类型 (0=站立, 1=行走, 2=小跑)
float32 linear_velocity    # 前进速度 (m/s)
float32 angular_velocity   # 旋转速度 (rad/s)
float32 lateral_velocity   # 横向速度 (m/s)
float32 step_height       # 步高 (m)
float32 step_length       # 步长 (m)

---
# 步态切换服务响应
bool success              # 切换是否成功
string message            # 响应消息